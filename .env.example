# Copy to .env.local and fill in. Never commit real values.

# PostgreSQL connection (local docker compose uses host port 5433).
DATABASE_URL=postgres://tablequeue:tablequeue@localhost:5433/tablequeue

# Database used by `npm run test:integration` (tables are truncated between tests).
TEST_DATABASE_URL=postgres://tablequeue:tablequeue@localhost:5433/tablequeue_test

# Auth.js signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Time zone that defines the restaurant's service day (PRD §4.1).
RESTAURANT_TIME_ZONE=America/Los_Angeles
